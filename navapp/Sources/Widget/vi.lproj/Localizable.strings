/* Live Activity strings (widget extension). Keys are the English text used in the Swift code. */

"You have arrived" = "Bạn đã tới nơi";
"Navigation Ended" = "Đã kết thúc chỉ đường";
/* Arrival time and remaining distance, e.g. "Đến 19:25 · 8,4 km". */
"ETA %@ · %@" = "Đến %1$@ · %2$@";
/* Shown while the trip's route is being found. */
"Finding a route…" = "Đang tìm đường…";
/* Shown when the app stopped updating the activity mid-trip (e.g. it was closed), instead of a turn that may be out of date. */
"Open PebbleOpenNav" = "Mở PebbleOpenNav";
